# =============================================================================
# sayso — environment variables
# Copy this file to .env and fill in your values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Direct Postgres connection (used by scripts and migrations)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
# Supabase CLI access token (used by supabase CLI / CI)
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Algolia Search (all server-side — never expose ADMIN_KEY to the browser)
# -----------------------------------------------------------------------------
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_SEARCH_KEY=your_algolia_search_only_api_key
ALGOLIA_ADMIN_KEY=your_algolia_write_api_key
# Shared secret for the Supabase → Algolia sync webhook (any strong random string)
ALGOLIA_SYNC_SECRET=your_algolia_sync_webhook_secret

# -----------------------------------------------------------------------------
# Maps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token
# Optional — Google Maps fallback
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------------------------------------------------------------------
# System IDs (required — seed these from your Supabase data)
# -----------------------------------------------------------------------------
SYSTEM_BUSINESS_ID=your_system_business_uuid
SYSTEM_USER_ID=your_system_user_uuid

# -----------------------------------------------------------------------------
# Email — Postmark (primary)
# -----------------------------------------------------------------------------
NEXT_POSTMARK_API_KEY=your_postmark_api_key
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=YourAppName

# Email — Resend (alternative)
RESEND_API_KEY=re_your_resend_api_key

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key

# -----------------------------------------------------------------------------
# Event ingestion (optional)
# -----------------------------------------------------------------------------
TICKETMASTER_API_KEY=your_ticketmaster_api_key
TICKETMASTER_SECRET=your_ticketmaster_secret
QUICKET_API_KEY=your_quicket_api_key
QUICKET_USER_TOKEN=your_quicket_user_token
FOURSQUARE_API_KEY=your_foursquare_api_key
ENABLE_TICKETMASTER_INGEST=false

# -----------------------------------------------------------------------------
# SMS / OTP providers (optional — configure one)
# -----------------------------------------------------------------------------
SMS_PROVIDER=africas_talking
SMS_FROM=YourAppName
PHONE_OTP_MODE=africas_talking
OTP_PEPPER=your_random_otp_pepper_string

# Africa's Talking
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username

# Twilio (alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# -----------------------------------------------------------------------------
# Mobile push (optional — for Expo companion app)
# -----------------------------------------------------------------------------
PUSH_DISPATCH_SECRET=your_push_dispatch_secret
EXPO_ACCESS_TOKEN=your_expo_access_token

# -----------------------------------------------------------------------------
# Cron / background jobs
# -----------------------------------------------------------------------------
CRON_SECRET=your_cron_secret_key
RUN_ON_START=false

# -----------------------------------------------------------------------------
# Auth rate-limiting (optional overrides)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAX_LOGIN_ATTEMPTS=5
NEXT_PUBLIC_LOCKOUT_DURATION_MINUTES=15

# -----------------------------------------------------------------------------
# Third-party integrations (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UBER_CLIENT_ID=your_uber_client_id
MEETUP_CLIENT_KEY=your_meetup_client_key
MEETUP_SIGNING_SECRET=your_meetup_signing_secret

# -----------------------------------------------------------------------------
# E2E testing (Playwright) — do not use real accounts in CI
# -----------------------------------------------------------------------------
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your_admin_test_password
E2E_PERSONAL_ACCOUNT_EMAIL=tester@example.com
E2E_PERSONAL_ACCOUNT_PASSWORD=your_tester_password

# -----------------------------------------------------------------------------
# Debug / local development only — never set in production
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_PERF_MONITOR=false
DEBUG_FOR_YOU_EMAIL=your_debug_email@example.com
DEBUG_FOR_YOU_PASSWORD=your_debug_password
